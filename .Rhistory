install_satu_package <- function(pkg) {
if (requireNamespace(pkg, quietly = TRUE)) {
message(
"[OK] ",
pkg,
" sudah terpasang."
)
return(
invisible(TRUE)
)
}
message(
"\nMeng-install: ",
pkg
)
hasil <- tryCatch(
{
install.packages(
pkg,
dependencies = TRUE
)
requireNamespace(
pkg,
quietly = TRUE
)
},
error = function(e) {
message(
"[GAGAL] ",
pkg,
": ",
conditionMessage(e)
)
FALSE
}
)
if (isTRUE(hasil)) {
message(
"[BERHASIL] ",
pkg
)
} else {
message(
"\nPackage ",
pkg,
" belum berhasil dipasang."
)
}
invisible(hasil)
}
# Install SATU PER SATU agar error mudah diketahui.
install_satu_package("sf")
install_satu_package("terra")
# Opsional:
install_satu_package("readxl")
